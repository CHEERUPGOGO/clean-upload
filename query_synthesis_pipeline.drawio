    <!-- ===== Arrow: Data → Task Synthesis ===== -->
    <mxCell id="arrow1" value="LLM-based Task Synthesis" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=1.5;fontColor=#333333;fontSize=10;labelBackgroundColor=none;" edge="1" parent="1" source="datasource_bg" target="tasks_icon">
